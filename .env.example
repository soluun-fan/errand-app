# Copy to .env.local and fill in.
# Local:  `npm run db:start` prints these (API URL, Publishable key, Secret key).
# Hosted: Supabase dashboard → Project Settings → API Keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security — never expose to the browser.
SUPABASE_SECRET_KEY=

# Development only: show the login code on screen instead of sending an SMS.
# Never set this on a deployment real users can reach.
DEV_SHOW_SMS_CODES=true

# Payment provider. "mock" (default) shows a "Simulate bank confirmation" button instead of real QPay.
PAYMENT_PROVIDER=mock

# Web Push (VAPID). Generate with: node -e 'console.log(require("web-push").generateVAPIDKeys())'
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Protects /api/cron/tick (Authorization: Bearer <value>)
CRON_SECRET=

# Own TURN relay for calls (coturn, `use-auth-secret`). When both are set, calls are RELAY-ONLY:
# they connect on any network and neither side sees the other's IP. Leave empty for direct calls.
TURN_URLS=
TURN_SECRET=

# Public deployment without a real SMS provider: ONLY these numbers can sign in (comma-separated).
TEST_PHONES=

# Private testing only: any phone-verified adult can activate helper access without uploading ID
# documents or entering bank details. Keep false on public deployments.
UNVERIFIED_HELPERS_TEST_MODE=false

# --- Go-live (docs/deploy.md "Go-live checklist") ---
# Real login SMS through a Mongolian gateway (src/lib/sms.ts). Supabase → Auth Hooks → Send SMS → HTTPS
# → https://<your address>/api/auth/sms; its secret ("v1,whsec_…") goes in SEND_SMS_HOOK_SECRET.
SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_METHOD=
SMS_HTTP_BODY=
SMS_HTTP_HEADERS=
SMS_HTTP_OK=
SEND_SMS_HOOK_SECRET=

# For Verify.MN login set SMS_PROVIDER=verify-mn and DEV_SHOW_SMS_CODES=false.
# Keep the Postgres send_sms_hook active. The key is server-only.
VERIFY_MN_API_KEY=

# Call relay: Cloudflare TURN (dashboard → Realtime → TURN). Calls become relay-only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Real payments (docs/deploy.md "Going live with wire.mn"): PAYMENT_PROVIDER=wire plus:
WIRE_SECRET_KEY=
WIRE_WEBHOOK_SECRET=

# Browser tests only — NEVER on a deployment (lets helpers skip the phone/location/notification check).
# E2E_DEVICE_BYPASS=
