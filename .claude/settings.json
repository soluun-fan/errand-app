{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-tidy.mjs\"",
            "timeout": 60,
            "statusMessage": "Tidying the edited file (Prettier + ESLint)"
          }
        ]
      }
    ]
  }
}
