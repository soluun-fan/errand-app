# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# example env file is committed
!.env.example

# browser tests (Playwright)
/test-results/
/playwright-report/

# copied from node_modules on install (scripts/copy-map-worker.mjs)
/public/vendor/

# test sessions kept between browser-test runs (e2e/support.ts)
/e2e/.auth/

# Other sites captured for design study (site-study skill) — never shipped
reference/inspo/
